# Leave VITE_API_URL unset to run on the in-memory mock API (default).
# Set it to use the real backend: empty string = same origin as the page, or a full URL such as https://api.example.com
# Local Laravel backend (cd backend && php artisan serve --port=8001):
# VITE_API_URL=http://localhost:8001/api
# VITE_API_URL=
